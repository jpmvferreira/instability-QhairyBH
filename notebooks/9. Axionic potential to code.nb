Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"C1", "[", "x_", "]"}], "=", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "x"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"C2", "[", "x_", "]"}], "=", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[Delta]2"}], " ", 
     SuperscriptBox["x", "n2"]}]]}], ";"}]}], "Input",
