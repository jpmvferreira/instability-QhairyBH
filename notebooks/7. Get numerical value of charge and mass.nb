Cell["The Komar mass, computed at the furthest point we have, is", "Text",
 CellChangeTimes->{{3.954387600230379*^9, 3.954387615026317*^9}, {
  3.954909050984744*^9, 
  3.954909055093563*^9}},ExpressionUUID->"88ffe412-ab5b-4c0c-91b9-\
e3ed2de10947"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MK", "=", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"F0", "[", 
      RowBox[{"[", "Nt", "]"}], "]"}], "+", 
     RowBox[{"F1", "[", 
      RowBox[{"[", "Nt", "]"}], "]"}]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", "rh"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"r", "[", 
          RowBox[{"[", "Nt", "]"}], "]"}], "2"], "-", 
        SuperscriptBox["rh", "2"]}], ")"}], 
      RowBox[{"dF0", "[", 
       RowBox[{"[", "Nt", "]"}], "]"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9543876164987507`*^9, 3.954387638199444*^9}, {
  3.954387771309965*^9, 3.954387857089034*^9}, {3.954908712446755*^9, 
