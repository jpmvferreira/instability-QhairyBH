Cell[CellGroupData[{

Cell["Computing charge of the scalar field", "Section",
 CellChangeTimes->{{3.955511510650594*^9, 
  3.955511517447685*^9}},ExpressionUUID->"b814e3ca-d484-4f93-a357-\
16108142d375"],

Cell["\<\
In here I\[CloseCurlyQuote]m computing the charge of the scalar field as a \
volume integral.
This is only relevant to double check the computation above where I computed \
the total charge and the charge of the BH, and then used that to compute the \
charge of the scalar field.\
\>", "Text",
 CellChangeTimes->{{3.9558611884051647`*^9, 
  3.955861262755528*^9}},ExpressionUUID->"c031a716-d65b-4d17-b22f-\
3755a6b5a2ef"],

Cell[TextData[{
 "Given that there\[CloseCurlyQuote]s a division by 0 at ",
 Cell[BoxData[
  RowBox[{"r", "=", 
   SubscriptBox["r", "h"]}]],
  FormatType->StandardForm,ExpressionUUID->
  "a01e74ef-cd71-4c7f-877e-baf72bdd10fc"],
 ", we approximate the function ",
 Cell[BoxData["V"],
  FormatType->StandardForm,ExpressionUUID->
  "a43f3950-5efc-4756-afd1-a40dda1e06be"],
 " by a Taylor series that is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"V", "[", 
    SubscriptBox["r", "h"], "]"}], "=", 
   FractionBox["\[Omega]", "q"]}]],
  FormatType->StandardForm,ExpressionUUID->
  "2927c8d3-abae-4a9d-a222-7a49cc7c5d6d"],
 " and avoid the indetermination in the computation of the integral"
}], "Text",
 CellChangeTimes->{{3.955512284685607*^9, 
  3.955512343258794*^9}},ExpressionUUID->"075d3605-2868-4b48-9263-\
a28925fb5ce1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"number", " ", "of", " ", "points", " ", "to", " ", "select"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"n2", " ", "=", " ", "50"}], ";"}]}]], "Input",
 CellChangeTimes->{3.955514448108331*^9},
 CellLabel->"In[36]:=",ExpressionUUID->"1b943499-8c19-4e6e-8e1f-b941312e52df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "N\.ba", " ", "of", " ", "coefficients", " ", "in", " ", "Taylor", " ", 
    "series"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Ncoef", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coef", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Symbol", "[", 
         RowBox[{"\"\<c\>\"", "<>", 
          RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], ",", "Ncoef"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "fit", " ", "a", " ", "curve", " ", "and", " ", "show", " ", "its", " ", 
     "expression"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"model2", "=", 
     RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"r", ",", "V"}], "}"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "n2"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        FractionBox["\[Omega]", "q"], "+", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "2"}], "Ncoef"], 
         RowBox[{
          RowBox[{"coef", "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"R", "-", "rh"}], ")"}], "i"]}]}]}], ",", 
       "\[IndentingNewLine]", "coef", ",", "\[IndentingNewLine]", "R"}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vfit", "=", 
     RowBox[{"model2", "[", "\"\<BestFit\>\"", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.955512519498368*^9, 3.955512523256513*^9}, {
   3.95551262358587*^9, 3.955512623881267*^9}, {3.955512654617687*^9, 
   3.955512705705331*^9}, {3.955512909341674*^9, 3.95551292331828*^9}, {
   3.955513061852907*^9, 3.9555130886984253`*^9}, {3.955513466226314*^9, 
