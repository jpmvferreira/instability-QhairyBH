Cell[TextData[{
 "Given that the total charge is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["Q", "T"], "=", 
   RowBox[{
    SubscriptBox["Q", "H"], "+", 
    SubscriptBox["Q", "\[Phi]"]}]}]],ExpressionUUID->
  "878d80db-570c-4636-bbee-ef51e801ed0b"],
 ", then the charge of the electric field must be"
}], "Text",
