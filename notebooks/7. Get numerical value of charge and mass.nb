Cell["Interpolate the numerical quantities to compute the integral", "Text",
 CellChangeTimes->{{3.955515086983879*^9, 
  3.9555151214555473`*^9}},ExpressionUUID->"5e12f468-abf0-4ce6-ac9a-\
c31e19014499"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"IF0", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"r", ",", "F0"}], "}"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", "Nt"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IF1", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"r", ",", "F1"}], "}"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", "Nt"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"I\[Phi]", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"r", ",", "\[Phi]"}], "}"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", "Nt"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IV", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"r", ",", "V"}], "}"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", "Nt"}], "]"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"d3fcb8ef-5efd-4d22-b232-90de11813a53"],

Cell["\<\
Compute the integral with far-away solution plus near horizon solution\
\>", "Text",
 CellChangeTimes->{{3.955515123397914*^9, 
  3.955515134361829*^9}},ExpressionUUID->"9f0fb848-8019-402a-a580-\
ae0d4185e32e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], "q", " ", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"3", 
         RowBox[{"IF1", "[", "R", "]"}]}], "-", 
        RowBox[{"IF0", "[", "R", "]"}]}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"R", "+", "rh"}], ")"}], "7"], 
      RowBox[{"(", 
       RowBox[{"\[Omega]", "-", 
        RowBox[{"q", " ", 
         RowBox[{"IV", "[", "R", "]"}]}]}], ")"}], 
      SuperscriptBox[
       RowBox[{"I\[Phi]", "[", "R", "]"}], "2"]}], 
     RowBox[{
      SuperscriptBox["R", "4"], 
      RowBox[{"(", 
       RowBox[{"R", "-", "rh"}], ")"}]}]]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"R", ",", 
     RowBox[{"r", "[", 
      RowBox[{"[", 
       RowBox[{"n2", "+", "1"}], "]"}], "]"}], ",", 
     RowBox[{"r", "[", 
      RowBox[{"[", "Nt", "]"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.955514741569708*^9, 3.955514843335266*^9}, {
  3.9555148996640577`*^9, 3.9555150091003447`*^9}, {3.955515047064546*^9, 
  3.955515067200817*^9}, {3.955515171132674*^9, 3.9555151824235077`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"91311ca9-b8f2-4b86-b92c-f01f7ee1f262"],

