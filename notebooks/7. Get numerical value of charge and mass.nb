   3.955514054479885*^9}, {3.955514104163805*^9, 3.9555141532684937`*^9}, {
   3.955514201597182*^9, 3.955514201637522*^9}, {3.955514250578569*^9, 
   3.955514256703306*^9}, {3.95551430760159*^9, 3.955514415433037*^9}, 
   3.955514451376989*^9},
 CellLabel->"In[37]:=",ExpressionUUID->"c43e3eb8-9a29-445b-b095-b250432e5ae8"],

