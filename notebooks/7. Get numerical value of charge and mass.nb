Cell[CellGroupData[{

Cell["Estimate of radius for the hair", "Section",
 CellChangeTimes->{{3.955257271663542*^9, 
  3.95525728670158*^9}},ExpressionUUID->"ac321b12-b878-469d-a8d3-\
8fa9bbeb0943"],

Cell[TextData[{
 "Create an interpolating function with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["Q", "\[Phi]"], "[", "R", "]"}]],
  FormatType->StandardForm,ExpressionUUID->
  "bea42ad1-2980-465e-bf63-427b476e51ec"],
 " as a function of the isotropic radius ",
 Cell[BoxData["R"],
  FormatType->StandardForm,ExpressionUUID->
  "9fd2365b-95f8-4462-9362-a1c04cc7336a"]
}], "Text",
 CellChangeTimes->{{3.955258093922719*^9, 
  3.9552581131722813`*^9}},ExpressionUUID->"177c487b-4bb0-4cf4-a24b-\
6c055748a919"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Q", "=", 
   RowBox[{"Interpolation", "[", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"F1", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"F0", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]]}], 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"r", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", "rh"}], ")"}], "3"], 
           RowBox[{
            RowBox[{"r", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", "rh"}]], 
          RowBox[{"dV", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "-", "Qh"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", 
        RowBox[{"Length", "[", "r", "]"}]}], "}"}]}], "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "remove", " ", "value", " ", "at", " ", "the", " ", "horizon", " ", 
       "because", " ", "of", " ", 
       RowBox[{"1", "/", "0"}]}], " ", "*)"}], "\[IndentingNewLine]", "]"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.95525780135429*^9, 3.95525781070383*^9}, {
  3.955257849754267*^9, 3.955257865329014*^9}, {3.955258032968507*^9, 
  3.955258033297843*^9}, {3.955272229488482*^9, 3.95527223047906*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"bf71dd0e-6d0b-4973-b8dc-7415315d6e04"],

Cell[TextData[{
 "Now find the value of the radius ",
 Cell[BoxData["R"],
  FormatType->StandardForm,ExpressionUUID->
  "3e67c596-7d9e-4b9c-9a08-923fc32c6af0"],
 " which has a specific percentage of the total hair"
}], "Text",
 CellChangeTimes->{{3.955258116133149*^9, 
  3.955258144184132*^9}},ExpressionUUID->"9aaae321-c32d-4989-91af-\
4ab2a440eb31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NSolve", "[", "\[IndentingNewLine]", 
  RowBox[{
