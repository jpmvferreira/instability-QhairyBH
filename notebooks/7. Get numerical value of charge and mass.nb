Cell[CellGroupData[{

Cell["Computing Total Charge and Mass", "Section",
 CellChangeTimes->{{3.954907791721552*^9, 3.954907797104217*^9}, {
  3.954908051747113*^9, 
  3.954908054614962*^9}},ExpressionUUID->"cb755596-f302-44ea-a033-\
bbb0e44eb5bb"],

Cell[TextData[{
 "Instead of computing the limit, we are going to take the highest values we \
have available, to compute the total charge ",
 Cell[BoxData[
  SubscriptBox["Q", "T"]],
  FormatType->StandardForm,ExpressionUUID->
  "8b524efc-5293-4083-bd1f-7783b5cf2a87"],
 ". Note that In [Herdeiro2020], this quantity is called ",
 Cell[BoxData[
  SubscriptBox["Q", "e"]],
  FormatType->StandardForm,ExpressionUUID->
  "325814da-c191-4fef-a353-1a261d55de3d"],
 "."
}], "Text",
 CellChangeTimes->{{3.953888339378106*^9, 3.953888351665913*^9}, {
  3.95388841081826*^9, 3.953888442802824*^9}, {3.954907810901623*^9, 
  3.9549078318776913`*^9}, {3.954908732524803*^9, 3.954908747691535*^9}, {
  3.954908992177371*^9, 
  3.954909035274622*^9}},ExpressionUUID->"32b383db-1ead-431d-a034-\
dac66c330b6d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QT", "=", 
  RowBox[{
   RowBox[{"-", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"F1", "[", 
       RowBox[{"[", "Nt", "]"}], "]"}], "-", 
      RowBox[{"F0", "[", 
       RowBox[{"[", "Nt", "]"}], "]"}]}]]}], 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"[", "Nt", "]"}], "]"}], "+", "rh"}], ")"}], "3"], 
    RowBox[{
     RowBox[{"r", "[", 
      RowBox[{"[", "Nt", "]"}], "]"}], "-", "rh"}]], 
   RowBox[{"dV", "[", 
    RowBox[{"[", "Nt", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.953885173846605*^9, 3.953885202554206*^9}, {
   3.953885471212488*^9, 3.953885508446885*^9}, {3.953887774743968*^9, 
