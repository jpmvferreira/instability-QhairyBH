Cell[BoxData[
 RowBox[{"\[LeftGuillemet]", "+", 
  RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], "q", " ", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"IF1", "[", "R", "]"}]}], "-", 
         RowBox[{"IF0", "[", "R", "]"}]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"R", "+", "rh"}], ")"}], "7"], 
       RowBox[{"(", 
        RowBox[{"\[Omega]", "-", 
         RowBox[{"q", " ", "Vfit"}]}], ")"}], 
       SuperscriptBox[
        RowBox[{"I\[Phi]", "[", "R", "]"}], "2"]}], 
      RowBox[{
       SuperscriptBox["R", "4"], 
       RowBox[{"(", 
        RowBox[{"R", "-", "rh"}], ")"}]}]]}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
