Cell[TextData[{
 "Computing the value of ",
 Cell[BoxData[
  SubscriptBox["Q", "h"]],
  FormatType->StandardForm,ExpressionUUID->
  "3a2c6a19-cd5b-4564-83c5-637ad3606f48"],
 " using the limit above"
}], "Text",
 CellChangeTimes->{
  3.954907596172789*^9, {3.95490774473667*^9, 
   3.9549077544775457`*^9}},ExpressionUUID->"379ba229-441f-436d-b534-\
1bc367498f8e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Qh", "=", 
  RowBox[{
   RowBox[{"-", "8"}], 
   SuperscriptBox["rh", "3"], 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"F1", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "-", 
     RowBox[{"F0", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]], 
   RowBox[{
    SubscriptBox["\[Limit]", 
     RowBox[{"R", "->", "rh"}]], 
    FractionBox["dVfit", 
     RowBox[{"R", "-", "rh"}]]}]}]}]], "Input",
 CellChangeTimes->{{3.953888177916073*^9, 3.953888243657887*^9}, {
   3.953888355305984*^9, 3.953888406094398*^9}, 3.954907700316789*^9, {
