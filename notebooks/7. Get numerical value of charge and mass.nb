Cell[BoxData[
 RowBox[{"\[LeftGuillemet]", ":=", 
  RowBox[{"Out", "[", "\[IndentingNewLine]", 
   RowBox[{"ToExpression", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"StringCases", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PreviousCell", "[", 
           RowBox[{"CellStyle", "->", "\"\<Output\>\""}], "]"}], "//", 
          "NotebookRead"}], "//", "Last"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<Out[\>\"", "~~", 
         RowBox[{"d", ":", 
          RowBox[{"DigitCharacter", ".."}]}], "~~", "\"\<]\>\""}], ":>", 
        "d"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"e1cb805b-1849-4f8a-9ddd-c524ef8c7831"],

Cell["\<\
Import the data from the elliptic solver, but remove the last point which \
corresponds to spatial infinity\
\>", "Text",
 CellChangeTimes->{{3.953885522020557*^9, 3.953885542225009*^9}, {
  3.954908575629114*^9, 3.954908591145117*^9}, {3.955257220976626*^9, 
  3.955257225705261*^9}},ExpressionUUID->"4c47077e-ef6d-43f8-ad8e-\
e027a0139be0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"import", " ", "the", " ", "CSV", " ", "file"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{
     "Import", "[", "\[IndentingNewLine]", 
      "\"\</home/undercover/projects/cactus/repos/magnetoscalar/MagScalarInit/\
etc/QHairyBH/alpha=0.1_q=0.3385_mu=1_gamma=3.97887/upper/rh=0.2000/w=0.700/\
output.csv\>\"", "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"TODO", ":", " ", 
     RowBox[{
     "fetch", " ", "this", " ", "from", " ", "the", " ", "file", " ", 
      "automatically"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"q", "=", "0.3385"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rh", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]", "=", "0.7"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "remove", " ", "all", " ", "comments", " ", "from", " ", "CSV", " ", 
     "file"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"data", ",", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"StringStartsQ", "[", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\"\<#\>\""}], 
          "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"fetch", " ", "data"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "i"}], "]"}], "]"}], " ", "->", " ", 
     RowBox[{
     "fetches", " ", "all", " ", "elements", " ", "from", " ", "column", " ", 
      "i"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{
         RowBox[{"Length", "[", "arr", "]"}], "-", "1"}]}], "]"}], "]"}], " ",
      "->", " ", 
     RowBox[{
      RowBox[{
      "slice", " ", "1", "D", " ", "array", " ", "to", " ", "go", " ", "from",
        " ", "2", "nd", " ", "element", " ", "to", " ", "the", " ", "N"}], 
      "-", "1"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"x", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{
         RowBox[{"Length", "[", "x", "]"}], "-", "1"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F1", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F1", "=", 
     RowBox[{"F1", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{
         RowBox[{"Length", "[", "F1", "]"}], "-", "1"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F0", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F0", "=", 
     RowBox[{"F0", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{
         RowBox[{"Length", "[", "F0", "]"}], "-", "1"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dF0", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "5"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dF0", "=", 
     RowBox[{"dF0", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{
         RowBox[{"Length", "[", "dF0", "]"}], "-", "1"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "6"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]", "=", 
     RowBox[{"\[Phi]", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{
         RowBox[{"Length", "[", "\[Phi]", "]"}], "-", "1"}]}], "]"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "8"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V", "=", 
     RowBox[{"V", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{
         RowBox[{"Length", "[", "V", "]"}], "-", "1"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dV", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "9"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dV", "=", 
     RowBox[{"dV", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{
         RowBox[{"Length", "[", "dV", "]"}], "-", "1"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
   RowBox[{"(*", " ", 
    RowBox[{"total", " ", "length", " ", "of", " ", "each", " ", "vector"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Nt", "=", 
     RowBox[{"Length", "[", "x", "]"}]}], ";"}]}]}]], "Input",
