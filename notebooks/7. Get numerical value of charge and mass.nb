Cell[TextData[{
 "From my computations, the charge ",
 Cell[BoxData["Q"],
  FormatType->StandardForm,ExpressionUUID->
  "a3381c1c-3b10-454d-8b4c-ed10e8f8c36c"],
 " as a function of the radius is\n\t",
 Cell[BoxData[
  RowBox[{"Q", "=", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       SubscriptBox["F", "1"], "-", 
       SubscriptBox["F", "0"]}]]}], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"r", "+", 
        SubscriptBox["r", "h"]}], ")"}], "3"], 
     RowBox[{"r", "-", 
      SubscriptBox["r", "h"]}]], 
    RowBox[{"V", "'"}]}]}]],
  FormatType->StandardForm,ExpressionUUID->
  "fda96dc3-4fef-4e8f-be83-a035d738471e"]
}], "Text",
 CellChangeTimes->{{3.954907059645546*^9, 3.954907149307529*^9}, {
  3.954908296418172*^9, 
  3.954908296418343*^9}},ExpressionUUID->"cf1d19ac-91b2-490f-8708-\
ebe539345f02"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"V", "'"}], "[", 
    SubscriptBox["r", "h"], "]"}], "=", "0"}]],
  FormatType->StandardForm,ExpressionUUID->
  "e1199756-8bed-4fc4-85b0-657cd6b19b9f"],
 ", the value of the charge of the horizon ",
 Cell[BoxData[
  SubscriptBox["Q", "h"]],
  FormatType->StandardForm,ExpressionUUID->
  "746e6f9a-20a7-45a6-8d0e-ebaf9b250d9c"],
 " is given by the limit\n\t",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["Q", "h"], "=", 
   RowBox[{
    RowBox[{"-", "8"}], 
    SuperscriptBox[
     SubscriptBox["r", "h"], "3"], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{
       SubscriptBox["F", "1"], "[", 
       SubscriptBox["r", "h"], "]"}], "-", 
      RowBox[{
       SubscriptBox["F", "0"], "[", 
       SubscriptBox["r", "h"], "]"}]}]], 
    RowBox[{
     SubscriptBox["\[Limit]", 
      RowBox[{"r", "->", 
       SubscriptBox["r", "h"]}]], 
     FractionBox[
      RowBox[{"V", "'"}], 
      RowBox[{"r", "-", 
       SubscriptBox["r", "h"]}]]}]}]}]],
  FormatType->StandardForm,ExpressionUUID->
  "c1291f09-a0fb-43f6-b1a0-a065f3bbb1ac"]
}], "Text",
 CellChangeTimes->{{3.954907174156334*^9, 3.954907252475917*^9}, {
  3.954907296429616*^9, 
  3.954907311997813*^9}},ExpressionUUID->"34fd4ddf-ec26-4a9b-b31b-\
e7a72b2df205"],

Cell[TextData[{
 "As for the total charge, its given by the limit\n\t",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["Q", "T"], "=", 
   RowBox[{"-", 
    RowBox[{
     SubscriptBox["\[Limit]", 
      RowBox[{"r", "->", "\[Infinity]"}]], 
     RowBox[{
      SuperscriptBox["r", "2"], 
      RowBox[{"V", "'"}]}]}]}]}]],
  FormatType->StandardForm,ExpressionUUID->
  "56509ca3-b609-4eaf-971d-613b200201f3"]
}], "Text",
 CellChangeTimes->{{3.954907334489674*^9, 
  3.9549073840012913`*^9}},ExpressionUUID->"c49f1184-29ad-4e3f-9ac2-\
ab1a2bf1b1cb"],

Cell[TextData[{
 "There\[CloseCurlyQuote]s also the fact that the total charge is the sum of \
two contributions\n\t",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["Q", "T"], "=", 
   RowBox[{
    SubscriptBox["Q", "h"], "+", 
    SubscriptBox["Q", "\[Phi]"]}]}]],ExpressionUUID->
  "cb04b86e-94f5-444a-ac5e-df8ed7784a82"],
 "\nwhere\n\t",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["Q", "\[Phi]"], "=", 
   SubscriptBox["qQ", "N"]}]],ExpressionUUID->
  "8f496b7d-a303-472e-84e6-e09f88562f9c"],
 "\nwith ",
 Cell[BoxData["q"],ExpressionUUID->"899d4e9a-0207-467c-b251-1eb62ea3a7b2"],
 " the coupling constant and ",
 Cell[BoxData[
  SubscriptBox["Q", "N"]],ExpressionUUID->
  "80897598-0513-4711-9d4b-f391229b669b"],
 " the Noether charge of the scalar field\n\nYou can also compute the charge \
of the scalar field as\n\t",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["Q", "\[Phi]"], "=", 
   RowBox[{
    RowBox[{"-", "2"}], "q", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      SubscriptBox["r", "h"], "\[Infinity]"], 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"3", 
           SubscriptBox["F", "1"]}], "-", 
          SubscriptBox["F", "0"]}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r", "+", 
           SubscriptBox["r", "h"]}], ")"}], "7"], 
        RowBox[{"(", 
         RowBox[{"\[Omega]", "-", "qV"}], ")"}], 
        SuperscriptBox["\[Phi]\[Phi]", "*"]}], 
       RowBox[{
        SuperscriptBox["r", "4"], 
        RowBox[{"(", 
         RowBox[{"r", "-", 
          SubscriptBox["r", "h"]}], ")"}]}]], 
      RowBox[{"\[DifferentialD]", "r"}]}]}]}]}]],
  FormatType->StandardForm,ExpressionUUID->
  "ae9ca481-8d0b-4e71-ab69-3d88faa56a89"]
}], "Text",
 CellChangeTimes->{{3.954908124244674*^9, 3.954908184414555*^9}, {
  3.955512214945655*^9, 
  3.95551228014799*^9}},ExpressionUUID->"34eb151e-7c73-45a2-b5bf-\
21d7c7ba061b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Computing Charge at the Horizon", "Section",
 CellChangeTimes->{{3.9549073981193733`*^9, 
  3.954907402945331*^9}},ExpressionUUID->"94cd3780-5c8a-403b-b079-\
5fd874873a4d"],

Cell[TextData[{
 "Analytically we expect that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"V", "'"}], "[", 
    SubscriptBox["r", "h"], "]"}], "=", "0"}]],ExpressionUUID->
  "8ae3e685-6983-4bcb-baf3-5da62f1a494a"],
 ", but this is not satisfied numerically.\nTherefore, to compute the limit, \
we\[CloseCurlyQuote]re going to select a few points close to ",
 Cell[BoxData[
  RowBox[{"r", "=", 
   SubscriptBox["r", "h"]}]],
  FormatType->StandardForm,ExpressionUUID->
  "84bc37da-ce3f-46d3-899d-3a4b6aa7fc34"],
 " and fit a curve on ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"V", "'"}], "[", "r", "]"}]],ExpressionUUID->
  "454dd896-31fb-4109-b7de-86b356f172df"],
 " enforcing that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"V", "'"}], "[", 
    SubscriptBox["r", "h"], "]"}], "=", "0"}]],ExpressionUUID->
  "ca28f049-5861-4b37-99e4-6b9714df5803"],
 "."
}], "Text",
 CellChangeTimes->{{3.953887713198237*^9, 3.953887804434954*^9}, {
  3.953888304040444*^9, 3.953888308579595*^9}, {3.954907411820058*^9, 
  3.954907460833949*^9}},ExpressionUUID->"8104de58-4239-4257-abe7-\
e9f1cbd6f826"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"number", " ", "of", " ", "points", " ", "to", " ", "select"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"n", " ", "=", " ", "50"}], ";"}]}]], "Input",
 CellChangeTimes->{{3.954907569777898*^9, 3.9549075722436666`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"f147d3bd-85c8-4f80-b32f-fe62c7404c64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "fit", " ", "a", " ", "curve", " ", "and", " ", "show", " ", "its", " ", 
    "expression"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"model", "=", 
     RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"r", ",", "dV"}], "}"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "n"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"c1", 
         RowBox[{"(", 
          RowBox[{"R", "-", "rh"}], ")"}]}], "+", 
        RowBox[{"c2", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"R", "-", "rh"}], ")"}], "2"]}], "+", 
        RowBox[{"c3", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"R", "-", "rh"}], ")"}], "3"]}], "+", 
        RowBox[{"c4", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"R", "-", "rh"}], ")"}], "4"]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"c1", ",", "c2", ",", "c3", ",", "c4"}], "}"}], ",", 
       "\[IndentingNewLine]", "R"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"dVfit", "=", 
    RowBox[{"model", "[", "\"\<BestFit\>\"", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.953886493395259*^9, 3.953886519130679*^9}, {
  3.953886557976528*^9, 3.953886688484935*^9}, {3.953886721890038*^9, 
