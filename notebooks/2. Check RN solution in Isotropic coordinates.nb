  3.9103592739571047`*^9}},ExpressionUUID->"15a7ab5b-251c-4d12-b51a-\
5f2aa1bc7df1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CTensorIndependent", "[", 
   RowBox[{"ctensor", ":", 
    RowBox[{"CTensor", "[", 
     RowBox[{"array_", ",", "bases_", ",", "_"}], "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vbundles", ",", "indices", ",", "sym", ",", "T", ",", "res"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vbundles", "=", 
      RowBox[{"VBundleOfBasis", "/@", "bases"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"indices", "=", 
      RowBox[{"NewIndexIn", "/@", "vbundles"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"sym", "=", 
      RowBox[{
       RowBox[{"TensorSymmetry", "[", "array", "]"}], "/.", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"cyc", ":", 
           RowBox[{"System`Cycles", "[", "cycs_", "]"}]}], ",", "sign_"}], 
         "}"}], ":>", 
        RowBox[{"Times", "[", 
         RowBox[{"sign", ",", 
          RowBox[{"Cycles", "@@", "cycs"}]}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ListQ", "[", "sym", "]"}], ",", 
       RowBox[{"sym", "=", 
        RowBox[{"GenSet", "@@", "sym"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"$DefInfoQ", "=", "False"}], "}"}], ",", 
       RowBox[{"DefTensor", "[", 
        RowBox[{
         RowBox[{"T", "@@", "indices"}], ",", "vbundles", ",", "sym", ",", 
         RowBox[{"PrintAs", "->", "name"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ToTensorRules", "[", 
      RowBox[{"T", ",", "ctensor"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"frules", " ", "=", " ", 
      RowBox[{"Join", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"TensorValues", "[", "T", "]"}], "]"}], "/.", 
         RowBox[{"Last", "[", 
          RowBox[{"TensorValues", "[", "T", "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Last", "[", 
         RowBox[{"TensorValues", "[", "T", "]"}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"assoc", "=", "\[IndentingNewLine]", 
      RowBox[{"GroupBy", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"DeleteCases", "[", 
         RowBox[{"frules", ",", 
          RowBox[{"_", "->", "0"}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Last", "->", "First"}]}], "\[IndentingNewLine]", "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Keys", "[", "assoc", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9103284683457623`*^9, 3.91032849265734*^9}, {
