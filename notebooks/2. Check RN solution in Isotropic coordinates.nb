    "g", ",", "\[IndentingNewLine]", "coords", ",", "\[IndentingNewLine]", 
     RowBox[{"SignatureOfMetric", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"3", ",", "1", ",", "0"}], "}"}]}]}], "  ", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "metric", " ", "signature", " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["N", 
         RowBox[{"+", "1"}]], ",", 
        SubscriptBox["N", 
         RowBox[{"-", "1"}]], ",", 
        SubscriptBox["N", "0"]}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]",
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
