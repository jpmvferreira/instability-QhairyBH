Cell[BoxData[{
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", "M", "]"}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"DefConstantSymbol", "[", "Q", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rh", ":=", 
   FractionBox[
    SqrtBox[
     RowBox[{
      SuperscriptBox["M", "2"], "-", 
      SuperscriptBox["Q", "2"]}]], "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", ":=", 
    SqrtBox[
     RowBox[{"1", "+", 
      FractionBox["M", 
       RowBox[{"R", "[", "]"}]], "+", 
      FractionBox[
       SuperscriptBox["Rh", "2"], 
       SuperscriptBox[
        RowBox[{"R", "[", "]"}], "2"]]}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", ":=", 
   RowBox[{
    RowBox[{"R", "[", "]"}], 
    SuperscriptBox["\[Psi]", "2"]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "=", 
    RowBox[{"CTensor", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"1", "-", 
               RowBox[{
                SuperscriptBox["Rh", "2"], "/", 
                SuperscriptBox[
                 RowBox[{"R", "[", "]"}], "2"]}]}], 
              SuperscriptBox["\[Psi]", "2"]], ")"}], "2"]}], "0", "0", "0"},
         {"0", 
          SuperscriptBox["\[Psi]", "4"], "0", "0"},
         {"0", "0", 
          RowBox[{
           SuperscriptBox["\[Psi]", "4"], 
           SuperscriptBox[
            RowBox[{"R", "[", "]"}], "2"]}], "0"},
         {"0", "0", "0", 
          RowBox[{
           SuperscriptBox["\[Psi]", "4"], 
           SuperscriptBox[
            RowBox[{"R", "[", "]"}], "2"], 
           SuperscriptBox[
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "]"}], "]"}], "2"]}]}
        }], "\[NoBreak]", ")"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"matrix", " ", "form", " ", "of", " ", "g"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "coords"}], ",", " ", 
        RowBox[{"-", "coords"}]}], "}"}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "both", " ", "indices", " ", "in", " ", "the", " ", "previous", " ", 
       "form", " ", "are", " ", "down"}], " ", "*)"}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetCMetric", "[", "\[IndentingNewLine]", 
