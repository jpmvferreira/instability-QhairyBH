Cell["\<\
Add assumptions for the space-time variables defined previously, which are \
useful for Mathematica\[CloseCurlyQuote]s simplification routines\
\>", "Text",
 CellChangeTimes->{{3.909919404709935*^9, 3.909919427594459*^9}, {
  3.910344496305252*^9, 
  3.910344510671944*^9}},ExpressionUUID->"3ceef2e5-1547-4214-a44a-\
427894a8ae4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$assumptions", " ", "=", " ", 
   RowBox[{"$assumptions", " ", "&&", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t", "[", "]"}], " ", "\[Element]", " ", "Reals"}], "     ", "&&",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "[", "]"}], " ", ">=", " ", "0"}], "              ", "&&", 
    "\[IndentingNewLine]", 
    RowBox[{"0", " ", "<=", " ", 
     RowBox[{"\[Theta]", "[", "]"}], " ", "<", " ", "\[Pi]"}], "     ", "&&", 
    "\[IndentingNewLine]", 
    RowBox[{"0", " ", "<=", " ", 
     RowBox[{"\[Phi]", "[", "]"}], "<", " ", 
     RowBox[{"2", "\[Pi]"}]}]}]}], "  ", ";"}]], "Input",
 CellChangeTimes->{{3.909919419284389*^9, 3.9099195171591797`*^9}, {
  3.90991955144153*^9, 3.909919600972774*^9}, {3.909924935310207*^9, 
  3.909924945646592*^9}, {3.910065131565732*^9, 3.91006513566159*^9}, {
  3.910065725496708*^9, 3.9100657429418592`*^9}, {3.910090677335541*^9, 
  3.910090682817265*^9}, {3.910168707280547*^9, 3.910168708918497*^9}, {
  3.910359618303353*^9, 3.9103596183408327`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"28f27cd3-92bc-45f5-a41b-495f04847f41"],

Cell[TextData[{
 "Define a tensor ",
 Cell[BoxData[
 "g"], "InlineCode",ExpressionUUID->"093ce8e8-eff3-47b4-a5e9-43be125dfdd1"],
 ", and set it as the metric tensor."
}], "Text",
 CellChangeTimes->{{3.909739392637868*^9, 3.909739402917974*^9}, {
   3.909918352836442*^9, 3.909918368222823*^9}, 3.90991840616485*^9, 
