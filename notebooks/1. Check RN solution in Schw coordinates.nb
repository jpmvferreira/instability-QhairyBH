Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", "M", "]"}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"DefConstantSymbol", "[", "Q", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "=", 
    RowBox[{"CTensor", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox[
              RowBox[{"2", "M"}], 
              RowBox[{"r", "[", "]"}]], "+", 
             FractionBox[
              SuperscriptBox["Q", "2"], 
              SuperscriptBox[
               RowBox[{"r", "[", "]"}], "2"]]}], ")"}]}], "0", "0", "0"},
         {"0", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             FractionBox[
              RowBox[{"2", "M"}], 
              RowBox[{"r", "[", "]"}]], "+", 
             FractionBox[
              SuperscriptBox["Q", "2"], 
              SuperscriptBox[
               RowBox[{"r", "[", "]"}], "2"]]}], ")"}], 
           RowBox[{"-", "1"}]], "0", "0"},
         {"0", "0", 
          SuperscriptBox[
           RowBox[{"r", "[", "]"}], "2"], "0"},
         {"0", "0", "0", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"r", "[", "]"}], "2"], 
           SuperscriptBox[
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "]"}], "]"}], "2"]}]}
        }], "\[NoBreak]", ")"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"matrix", " ", "form", " ", "of", " ", "g"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "coords"}], ",", " ", 
        RowBox[{"-", "coords"}]}], "}"}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "both", " ", "indices", " ", "in", " ", "the", " ", "previous", " ", 
       "form", " ", "are", " ", "down"}], " ", "*)"}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetCMetric", "[", "\[IndentingNewLine]", 
    RowBox[{
    "g", ",", "\[IndentingNewLine]", "coords", ",", "\[IndentingNewLine]", 
     RowBox[{"SignatureOfMetric", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"3", ",", "1", ",", "0"}], "}"}]}]}], "  ", 
    RowBox[{"(*", " ", 
     RowBox[{"the", " ", "metric", " ", "signature", " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["N", 
         RowBox[{"+", "1"}]], ",", 
        SubscriptBox["N", 
         RowBox[{"-", "1"}]], ",", 
        SubscriptBox["N", "0"]}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]",
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "print", " ", "the", " ", "metric", " ", "in", " ", "matrix", " ", 
    "form"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"g", "[", 
  RowBox[{
   RowBox[{"-", "\[Mu]"}], ",", 
   RowBox[{"-", "\[Nu]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.909639964031664*^9, 3.909640041161768*^9}, {
