Cell["Set the metric tensor", "Text",
 CellChangeTimes->{{3.93246704639236*^9, 
  3.932467048910424*^9}},ExpressionUUID->"d9edc00f-1217-45e7-a69d-\
bd2ec73cf3fb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefScalarFunction", "[", "F0", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", "F1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", "S0", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefScalarFunction", "[", "S1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DefScalarFunction", "[", "\[Alpha]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"r", ":=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"x", "[", "]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"y", "[", "]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"z", "[", "]"}], "2"]}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "=", 
    RowBox[{"CTensor", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"\[Alpha]", "[", "r", "]"}], "2"]}], "0", "0", "0"},
         {"0", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"2", 
             RowBox[{"F1", "[", "r", "]"}]}]], 
           SuperscriptBox[
            RowBox[{"S1", "[", "r", "]"}], "4"]}], "0", "0"},
         {"0", "0", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"2", 
             RowBox[{"F1", "[", "r", "]"}]}]], 
           SuperscriptBox[
            RowBox[{"S1", "[", "r", "]"}], "4"]}], "0"},
         {"0", "0", "0", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"2", 
             RowBox[{"F1", "[", "r", "]"}]}]], 
           SuperscriptBox[
            RowBox[{"S1", "[", "r", "]"}], "4"]}]}
        }], "\[NoBreak]", ")"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "coords"}], ",", " ", 
        RowBox[{"-", "coords"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetCMetric", "[", "\[IndentingNewLine]", 
   RowBox[{
   "g", ",", "\[IndentingNewLine]", "coords", ",", "\[IndentingNewLine]", 
    RowBox[{"SignatureOfMetric", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"3", ",", "1", ",", "0"}], "}"}]}]}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "metric", " ", "signature", " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["N", 
        RowBox[{"+", "1"}]], ",", 
       SubscriptBox["N", 
        RowBox[{"-", "1"}]], ",", 
       SubscriptBox["N", "0"]}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.914498406070107*^9, 3.914498406639549*^9}, {
  3.925104801570312*^9, 3.9251048240468397`*^9}, {3.932465190458872*^9, 
  3.932465274255693*^9}, {3.93246575205901*^9, 3.932465782000855*^9}, {
