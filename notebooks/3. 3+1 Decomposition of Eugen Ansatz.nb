           RowBox[{"2", 
            RowBox[{"F1", "[", "r", "]"}]}]], 
          SuperscriptBox[
           RowBox[{"S1", "[", "r", "]"}], "4"]}]}
       }], "\[NoBreak]", ")"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
