"

# 3D HDF5 output
IOHDF5::out3d_every = 0
IOHDF5::out3d_vars  = "
"


#------------------------------------------------------------------------------
# Checkpoints and recovery
#-------------------------------------------------------------------------------

CarpetIOHDF5::checkpoint            = yes
IO::checkpoint_dir                  = "../checkpoints"
IO::checkpoint_ID                   = no
#IO::checkpoint_every_walltime_hours = 24
IO::checkpoint_on_terminate         = yes
IO::out_proc_every                  = 2
IO::checkpoint_keep                 = 1

IO::recover     = "autoprobe"
IO::recover_dir = "../checkpoints"

IO::abort_on_io_errors                      = yes
CarpetIOHDF5::open_one_input_file_at_a_time = yes
CarpetIOHDF5::compression_level             = 9


#------------------------------------------------------------------------------
# Termination
#-------------------------------------------------------------------------------

TerminationTrigger::max_walltime                 = 72  # hours
TerminationTrigger::on_remaining_walltime        = 30  # minutes
TerminationTrigger::output_remtime_every_minutes = 0
TerminationTrigger::termination_from_file        = yes
TerminationTrigger::termination_file             = "terminate.txt"
TerminationTrigger::create_termination_file      = yes

# termination condition
Cactus::terminate       = "time"
Cactus::cctk_final_time = 1800.
